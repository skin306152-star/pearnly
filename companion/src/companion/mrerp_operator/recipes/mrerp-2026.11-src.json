  "login": {
    "_doc": "login/login.php 的表单；checklogin.php 成功后 location=selectdb.php，失败 alert「User หรือ Password ไม่ถูกต้อง」再回 ../index.php；selectdb.php 每个年度账套一条 mainmenu.php?comidyear=N&seldb=1 链接；业务页 footer 写 Company : 全称、Database Name : 简称+年度（component/php/footer.php）。",
    "verified": false,
    "page": "login/login.php",
    "form_action": "checklogin.php",
    "user_id": "txtusers",
    "password_id": "txtpasswords",
    "submit_id": "btnsubmit",
    "select_page": "login/selectdb.php",
    "account_link": "a[href*=\"mainmenu.php?comidyear={comidyear}&seldb=\"]",
    "main_page": "login/mainmenu.php",
    "logout_page": "login/logout.php",
    "footer": "#footer",
    "company_label": "Company :",
    "database_label": "Database Name :",
    "login_paths": ["login/login.php", "login/logoutkick.php", "login/checklogin.php", "/index.php"]
  },
  "list": {
    "_doc": "{module}/allview.php?idmenu=N 先把菜单写进会话（component/php/sessionmenu.php）；搜索框 txtsearch + 按钮 btnsearch，结果由 component/showdata.php 追加进 #showdata，每行一个 <p>，前四格：单号、日期（佛历 dd/mm/yyyy）、名称、金额；查看链接 allform.php?id=N&status=vie；查不到是 <p id=\"nodata\">。新增按钮 btnadd（location='allform.php'）。不能用时整页只有「กรุณากำหนดการเชื่อมโยง …」/「กรุณาป้อนข้อมูล …」。",
    "verified": false,
    "view": "{module}/allview.php?idmenu={menu}",
    "search_id": "txtsearch",
    "search_button": "btnsearch",
    "rows": "#showdata",
    "add_id": "btnadd"
  },
  "forms": {
    "purchase": {
      "_doc": "赊购（货）：aptran（ใบซื้อ）。新单默认勾着「เงินสด」，赊购要取消勾选。选了供应商后页面 AJAX 带出信用天数（component/topcode.php）；选了商品后 AJAX 带出标准成本价覆盖单价（checkcoststd.php），所以单价要等它回来再填。",
      "module": "aptran",
      "verified": false,
      "cash": false,
      "phase": 1
    },
    "purchase_expense": {
      "_doc": "赊购（费用）：同 aptran 表单、费用菜单（菜单号由站点按公司选定，载荷 menu）。",
