#!/bin/sh
# Shared by this repository's worktrees. Validate the index, not unstaged fixes.
set -eu
if ! git diff --cached --name-only --diff-filter=ACDMR | grep -Eq '^(apps/|AGENTS\.md$|\.githooks/|scripts/check-architecture\.py$|docs/development/(architecture-policy|dms-module-map)\.json$)'; then
    exit 0
fi
staged=$(mktemp -d "${TMPDIR:-/tmp}/pearnly-architecture-index.XXXXXX")
trap 'rm -rf "$staged"' EXIT HUP INT TERM
git checkout-index --all --prefix="$staged/"
if [ ! -f "$staged/scripts/check-architecture.py" ]; then
    echo 'Architecture check unavailable in the staged branch; synchronize the repository development rules before committing.' >&2
    exit 1
fi
python3 "$staged/scripts/check-architecture.py"
