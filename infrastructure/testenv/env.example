# 测试机运行配置：只放在那台机器上（/opt/pearnly-testenv/env，权限 600），不进仓库。
# PEARNLY_IMAGE 必须是正式环境正在运行的那个 digest，不要用标签。
PEARNLY_IMAGE=ghcr.io/skin306152-star/pearnly/frappe@sha256:REPLACE_WITH_ACTIVE_DIGEST
DB_ROOT_PASSWORD=REPLACE
KEYCLOAK_DB_PASSWORD=REPLACE
KEYCLOAK_ADMIN_PASSWORD=REPLACE
# Keycloak 的对外主机名，测试机上用测试域名；接隧道后换成隧道域名。
AUTH_HOST=auth.test.localhost
