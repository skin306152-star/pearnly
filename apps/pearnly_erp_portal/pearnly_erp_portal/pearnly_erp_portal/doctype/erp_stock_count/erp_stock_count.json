{
 "doctype": "DocType",
 "name": "ERP Stock Count",
 "module": "Pearnly ERP Portal",
 "autoname": "format:STC-{#####}",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "title",
  "status",
  "warehouse",
  "column_break_top",
  "item_total",
  "counted_total",
  "difference_total",
  "notes",
  "column_break_time",
  "closed_at",
  "closed_by",
  "posted_at",
  "posted_by",
  "ledger_section",
  "ledger_state",
  "ledger_docnum",
  "ledger_reason",
  "ledger_sent_at",
  "ledger_job",
  "ledger_book",
  "ledger_needed",
  "ledger_target"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "length": 140
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nClosed\nPosted",
   "default": "Active",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Warehouse",
   "options": "ERP Warehouse"
  },
  {
   "fieldname": "column_break_top",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "item_total",
   "fieldtype": "Int",
   "label": "Rows",
   "read_only": 1
  },
  {
   "fieldname": "counted_total",
   "fieldtype": "Int",
   "label": "Counted",
   "read_only": 1
  },
  {
   "fieldname": "difference_total",
   "fieldtype": "Int",
   "label": "Differences",
   "read_only": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "column_break_time",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "closed_at",
   "fieldtype": "Datetime",
   "label": "Closed at",
   "read_only": 1
  },
  {
   "fieldname": "closed_by",
   "fieldtype": "Link",
   "label": "Closed by",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "posted_at",
   "fieldtype": "Datetime",
   "label": "Posted at",
   "read_only": 1
  },
  {
   "fieldname": "posted_by",
   "fieldtype": "Link",
   "label": "Posted by",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "ledger_section",
   "fieldtype": "Section Break",
   "label": "Express",
   "collapsible": 1
  },
  {
   "fieldname": "ledger_state",
   "fieldtype": "Select",
   "label": "Express Status",
   "options": "\nqueued\nwritten\nmismatch\nheld\nfailed\ndetached",
   "read_only": 1,
   "no_copy": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "ledger_docnum",
   "fieldtype": "Data",
   "label": "Express No.",
   "read_only": 1,
   "no_copy": 1,
   "search_index": 1
  },
  {
   "fieldname": "ledger_reason",
   "fieldtype": "Small Text",
   "label": "Express Note",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "ledger_sent_at",
   "fieldtype": "Datetime",
   "label": "Express Sent At",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "ledger_job",
   "fieldtype": "Data",
   "label": "Express Job",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1,
   "search_index": 1
  },
  {
   "fieldname": "ledger_book",
   "fieldtype": "Data",
   "label": "Express Account Set",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "ledger_needed",
   "fieldtype": "Long Text",
   "label": "Express Choices Needed",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "ledger_target",
   "fieldtype": "Select",
   "label": "Ledger",
   "options": "\nexpress\nmrerp",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ]
}
