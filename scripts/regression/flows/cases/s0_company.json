{
 "name": "s0_company",
 "datasets": ["new", "old"],
 "user": "admin",
 "start": "/desk/pearnly-home",
 "steps": [
  {"name": "起点：未连、普通、不接", "exec": ["cc-unplug", "${company}"], "file": ["js/lib_company.js", "js/s0_reset.js"]},
  {"name": "普通公司：资料页与新建物料无按台、按数量入库", "start": "/desk/pearnly-home", "file": ["js/lib_company.js", "js/s0_general.js"], "shot": true, "timeout_ms": 120000},
  {"name": "改汽车：新建物料出按台、入库要台", "file": ["js/lib_company.js", "js/s0_vehicle.js"], "shot": true, "timeout_ms": 120000},
  {"name": "勾接 Express（未连上）", "start": "/desk/pearnly-home", "file": ["js/lib_company.js", "js/s0_tick.js"], "timeout_ms": 60000},
  {"name": "未连上只显示未连接和下载", "start": "/desk/pearnly-home", "file": ["js/lib_company.js", "js/s0_offline.js"], "shot": true, "timeout_ms": 60000},
  {"name": "连上后可断开、可同步、不能直接取消", "exec": ["cc-connect", "${company}"], "start": "/desk/pearnly-home", "file": ["js/lib_company.js", "js/s0_connected.js"], "shot": true, "timeout_ms": 90000},
  {"name": "生产补丁自动勾已连 Express 的公司", "exec": ["patch-company-settings"], "file": "js/s0_patch.js"},
  {"name": "收尾：撤掉模拟账套", "exec": ["cc-unplug", "${company}"], "file": ["js/lib_company.js", "js/s0_reset.js"]}
 ]
}
