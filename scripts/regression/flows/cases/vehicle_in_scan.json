{
 "name": "vehicle_in_scan",
 "datasets": [
  "new"
 ],
 "user": "admin",
 "start": "/desk/pearnly-stock-in/new",
 "video": "qr-chassis.y4m",
 "variants": [
  {
   "vars": {
    "label": "入库",
    "route": "pearnly-stock-in",
    "dialog": "登记车辆",
    "chassis": "MR0LAB00000000001",
    "match": "MR0LAB00000000001",
    "warehouse": "${seed.stocked_warehouse}",
    "expect_wh": "${seed.stocked_warehouse}",
    "status": "in_stock",
    "cost": "450000"
   }
  }
 ],
 "steps": [
  {
   "name": "公司类型设为汽车",
   "js": "await call(\"pearnly_erp_portal.masters.api.api_update_company\", {name: \"${company}\", company_type: \"vehicle\"}); const v = await call(\"pearnly_erp_portal.masters.api.api_get_profile\", {name: \"${company}\"}, \"GET\"); return {ok: v.company_type === \"vehicle\", type: v.company_type};"
  },
  {
   "name": "按台入库扫车架号登记",
   "file": "js/vehicle_entry.js",
   "shot": true,
   "timeout_ms": 150000,
   "start": "/desk/pearnly-stock-in/new"
  },
  {
   "name": "收尾：公司类型改回普通",
   "js": "await call(\"pearnly_erp_portal.masters.api.api_update_company\", {name: \"${company}\", company_type: \"general\"}); return {ok: true};"
  }
 ]
}