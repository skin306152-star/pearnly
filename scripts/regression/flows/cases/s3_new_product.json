{
 "name": "s3_new_product",
 "datasets": ["new", "old"],
 "user": "stock",
 "start": "/desk/pearnly-home",
 "steps": [
  {"name": "准备本轮的码与停用商品", "exec": ["s3-prepare", "${seed.count_warehouse}"], "file": ["js/s3_lib.js", "js/s3_prepare.js"]},
  {"name": "桌面录入框就地新建并记数", "file": ["js/s3_lib.js", "js/s3_desk.js"], "shot": true, "timeout_ms": 120000},
  {"name": "同码只建一件、停用商品照样记数", "file": ["js/s3_lib.js", "js/s3_more.js"], "timeout_ms": 60000},
  {"name": "Excel 上传建档与问题行", "exec": ["count-sheet"], "file": ["js/s3_lib.js", "js/s3_sheet.js"], "timeout_ms": 90000},
  {"name": "过账", "file": ["js/s3_lib.js", "js/s3_post.js"], "timeout_ms": 90000},
  {"name": "接 Express 的公司就地新建并过账", "exec": ["express-on", "${company}"], "file": ["js/s3_lib.js", "js/s3_express_count.js"], "timeout_ms": 90000},
  {"name": "Express 停在没有这件商品", "exec": ["express-send", "${company}"], "file": ["js/s3_lib.js", "js/s3_express_held.js"]},
  {"name": "库里读回来由、行来源、自动启用", "exec": ["s3-inspect"], "file": ["js/s3_lib.js", "js/s3_inspect.js"]},
  {"name": "收尾：撤掉接 Express", "exec": ["express-off", "${company}"], "js": "return {ok: exec_out && exec_out.connected === false, exec_out};"}
 ]
}
